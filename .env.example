# The Codex provider uses saved CLI login; no API key is needed.
# Configure data-analysis models and call ceilings in configs/agents.yaml
# (managed services) or configs/agents_stdio.yaml (CLI-owned MCP processes).
# Custom command routers manage their own host-only credential storage.

# Copy this file to .env and enter your LOCAL PostgreSQL connection details.
# PostgreSQL runs directly on Windows, not in Docker. Never commit .env.
# Percent-encode special characters in the username/password portion of the URL.
MCP_LAB_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# Original CSVs and generated files stay on disk; their records live in PostgreSQL.
MCP_LAB_DATA_ROOT=runs/data_analysis
